generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum AccountType {
  Solidario
  Cuentadante
}

enum MaterialStatus {
  Disponible
  No_disponible
  Mantenimiento
  En_prestamo
  Traslado
  Baja
}

// --- Models ---

model DocumentType {
  id           Int    @id @default(autoincrement())
  documentName String @unique @db.VarChar(50)  @map("document_name")
  description  String? @db.VarChar(150)
  users        User[]

  @@map("document_types")
}

model Group {
  id          Int               @id @default(autoincrement())
  groupName   String            @unique @db.VarChar(100) @map("group_name")
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  permissions GroupPermission[]
  users       UserGroup[]

  @@map("groups")
}

model Permission {
  id             Int               @id @default(autoincrement())
  permissionName String            @unique @db.VarChar(100) @map("permission_name")
  description    String?           @db.VarChar(255)
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  groups         GroupPermission[]
  users          UserPermission[]

  @@map("permissions")
}

model GroupPermission {
  groupId      Int        @map("group_id")
  permissionId Int        @map("permission_id")
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
  @@map("group_permissions")
}

model User {
  id                 Int              @id @default(autoincrement())
  documentTypeId     Int              @map("document_type_id")
  documentType       DocumentType     @relation(fields: [documentTypeId], references: [id])
  userFirstName      String           @db.VarChar(100) @map("user_first_name")
  userLastName       String           @db.VarChar(100) @map("user_last_name")
  userDocumentNumber String           @unique @db.VarChar(20) @map("user_document_number")
  userEndDate        DateTime         @db.Date @map("user_end_date")
  userEmail          String           @unique @db.VarChar(150) @map("user_email")
  userPhone          String           @db.VarChar(15) @map("user_phone")
  userSecondPhone    String?          @db.VarChar(15) @map("user_second_phone")
  userAddress        String           @db.VarChar(150) @map("user_address")
  userIsActive       Boolean          @default(true) @map("user_is_active")
  userPhoto          String           @unique @map("user_photo")
  userPassword       String           @db.VarChar(255) @map("user_password")
  userAccountType    AccountType      @default(Solidario) @map("user_account_type")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  groups             UserGroup[]
  directPermissions  UserPermission[]
  consumableMaterials ConsumableMaterial[]
  loans              Loan[]
  tasks              Task[]

  @@map("users")
}

model UserGroup {
  userId     Int      @map("user_id")
  groupId    Int      @map("group_id")
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_groups")
}

model UserPermission {
  userId       Int        @map("user_id")
  permissionId Int        @map("permission_id")
  created_at   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Brand {
  id                  Int                  @id @default(autoincrement())
  brandName           String               @unique @db.VarChar(100) @map("brand_name")
  consumableMaterials ConsumableMaterial[]

  @@map("brands")
}

model Category {
  id                  Int                  @id @default(autoincrement())
  categoryName        String               @unique @db.VarChar(100) @map("category_name")
  returnableMaterials ReturnableMaterial[]

  @@map("categories")
}

model ConsumableMaterial {
  id            Int                 @id @default(autoincrement())
  userId        Int                 @map("user_id")
  brandId       Int                 @map("brand_id")
  user          User                @relation(fields: [userId], references: [id])
  brand         Brand               @relation(fields: [brandId], references: [id])
  senaPlate     String?             @unique @db.VarChar(20) @map("sena_plate")
  materialName  String              @db.VarChar(100) @map("material_name")
  image         String
  quantity      Int?
  unitPrice     Decimal             @db.Decimal(15, 2) @map("unit_price")
  totalPrice    Decimal             @db.Decimal(15, 2) @map("total_price")
  status        MaterialStatus
  description   String              @db.VarChar(255)
  purchaseDate  DateTime            @db.Date @map("purchase_date")
  location      String              @db.VarChar(100)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  returnable    ReturnableMaterial?
  loans         Loan[]
  loanReturns   LoanReturn[]

  @@map("consumable_materials")
}

model ReturnableMaterial {
  id                 Int                @id
  categoryId         Int                @map("category_id")
  consumableMaterial ConsumableMaterial @relation(fields: [id], references: [id], onDelete: Cascade)
  category           Category           @relation(fields: [categoryId], references: [id])
  model              String             @db.VarChar(100)
  serial             String             @unique @db.VarChar(20)
  technicalSheet     String             @map("technical_sheet")
  dimensions         String?            @db.VarChar(100)

  @@map("returnable_materials")
}

model Loan {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  materialId        Int                @map("material_id")
  user              User               @relation(fields: [userId], references: [id])
  consumableMaterial ConsumableMaterial @relation(fields: [materialId], references: [id])
  borrowedQuantity  Int                @map("borrowed_quantity")
  apprenticeGroup   Int                @map("apprentice_group")
  useJustification  String             @db.VarChar(255) @map("use_justification")
  returnDate        DateTime           @db.Date @map("return_date")
  loanDate          DateTime           @default(now()) @map("loan_date")
  loanReturns       LoanReturn[]

  @@map("loans")
}

model LoanReturn {
  id                 Int                @id @default(autoincrement())
  loanId             Int                @map("loan_id")
  materialId         Int                @map("material_id")
  loan               Loan               @relation(fields: [loanId], references: [id])
  consumableMaterial ConsumableMaterial @relation(fields: [materialId], references: [id])
  remainingQuantity  Int?               @map("remaining_quantity")
  observations       String             @db.VarChar(255)
  returnDate         DateTime           @default(now()) @map("return_date")

  @@map("loan_returns")
}

model Task {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  taskName    String   @db.VarChar(100) @map("task_name")
  description String   @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("tasks")
}
