# Variables del AMBIENTE DE PRUEBAS (Matriz de Casos de Prueba v6).
# Copia este archivo a .env.test y rellena los valores:
#   cp .env.test.example .env.test
#
# Lo usan los scripts npm "test:db:*" y "test:server" (ver tests/README.md).
# Las pruebas unitarias (npm test) NO lo usan: tienen sus propios valores ficticios
# en jest.setup.cjs y nunca tocan una base de datos.

# Base de datos EXCLUSIVA para pruebas. Por seguridad su nombre debe contener
# "test" y no puede ser la misma de .env: el seed de pruebas borra datos.
# Créala antes en PostgreSQL:  CREATE DATABASE sii_test;
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/sii_test"

# Debe ser 5000: el frontend apunta a http://localhost:5000/api.
# Detén `npm run dev` antes de levantar `npm run test:server`.
PORT=5000
FRONTEND_URL=http://localhost:5173

# Contraseña del SuperAdmin (superadmin@sia.local) que crea prisma/seed.js
ADMIN_PASSWORD="SuperAdmin123*"

# JWT — puede ser cualquier valor, pero distinto del de .env
JWT_SECRET=clave_ambiente_de_pruebas
JWT_EXPIRES=8h

# Contraseña de TODOS los usuarios de prueba que crea prisma/seed-test.js.
# Cumple la política de complejidad (mayúscula, minúscula, número y especial).
TEST_USERS_PASSWORD="Prueba123*"

# Buzón base para los correos de los usuarios de prueba. El seed arma cada correo
# con "+alias": pruebas.sii@gmail.com -> pruebas.sii+admin.ui@gmail.com
# Gmail entrega todas esas variantes en el MISMO buzón, así se reciben los enlaces
# de firma, las credenciales y los códigos de recuperación sin crear 14 cuentas.
TEST_EMAIL_BASE=pruebas.sii@gmail.com

# Correo saliente (credenciales, firma de préstamos, recuperación de contraseña).
# Opción A — Gmail de pruebas con contraseña de aplicación (igual que .env).
# Opción B — Mailtrap (atrapa todos los correos sin enviarlos de verdad):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io  EMAIL_PORT=2525  EMAIL_SECURE=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM="S.I.I - Pruebas <mismo-correo-que-EMAIL_USER>"
