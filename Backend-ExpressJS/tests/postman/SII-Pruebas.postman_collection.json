  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Regla común a TODAS las peticiones: el servidor nunca debe responder un error interno.",
          "pm.test('Sin error interno del servidor (no 5xx)', () => pm.expect(pm.response.code).to.be.below(500));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Sesiones",
      "description": "Inicia sesión con cada rol y guarda su token en el entorno (tokenAdmin, tokenInstructor, ...). La sesión es ÚNICA por usuario: no inicies sesión en el navegador con los usuarios \".api\". Al terminar, ejecuta la carpeta \"99 - Cerrar sesiones\".",
      "item": [
        {
          "name": "Iniciar sesión — Administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicio de sesión exitoso (200)', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('tokenAdmin', pm.response.json().token);",
                  "} else if (pm.response.code === 409) {",
                  "  console.warn('Ya hay una sesión abierta con este usuario. Ejecuta \"Cerrar sesión — Administrador\" o espera 5 minutos a que la sesión se libere sola.');",
                  "}"
                ]
              }
            }
          ]
        },
