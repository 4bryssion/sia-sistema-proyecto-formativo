{
  "name": "backend-expressjs",
  "version": "2.0.0",
  "description": "Sistema de gestión de inventario-Proyecto Formativo",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "revisar-duplicados": "node prisma/revisar-duplicados.js",
    "hashear-cotizaciones": "node prisma/hashear-cotizaciones.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:fixtures": "node tests/fixtures/generar-fixtures.js",
    "test:db:migrate": "node scripts/test-env.js npx prisma migrate deploy",
    "test:db:seed": "node scripts/test-env.js node prisma/seed.js && node scripts/test-env.js node prisma/seed-test.js",
    "test:db:setup": "npm run test:db:migrate && npm run test:db:seed",
    "test:server": "node scripts/test-env.js node src/server.js"
  },
  "keywords": [
    "MVC",
    "Node.js",
    "Express",
    "API REST",
    "Microservicios",
    "JavaScript",
    "Backend",
    "Programación",
    "Desarrollo web"
  ],
  "author": "Grupo 7-Proyecto formativo / Santiago Acevedo Medina - Sofía Cardona Ramírez - Maicol Esteban Franco Román",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.13"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
