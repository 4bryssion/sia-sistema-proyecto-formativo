# Copia este archivo a .env y rellena los valores reales:
#   cp .env.example .env

# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# Ejemplo local: postgresql://postgres:admin123@localhost:5432/inventoryDB
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME"

# Puerto en que corre el servidor Express (por defecto 5000)
PORT=5000

# URL del frontend — usada para armar enlaces de firma de préstamos por correo (P40)
FRONTEND_URL=http://localhost:5173

# Contraseña del usuario SuperUser — usada solo por prisma/seed.js
ADMIN_PASSWORD="CambiarEsta123!"

# JWT
JWT_SECRET=
JWT_EXPIRES=

# Correo (recuperación de contraseña) — Gmail con contraseña de aplicación
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Gmail ignora un "from" distinto del usuario autenticado (EMAIL_USER) y lo reemplaza en el envío
# real — dejar EMAIL_FROM con el mismo correo que EMAIL_USER (o solo el nombre visible) para no
# perseguir un "bug" que en realidad es una restricción de Gmail, no del código.
EMAIL_FROM="S.I.I - Software de Inventario de Infraestructura  <mismo-correo-que-EMAIL_USER>"